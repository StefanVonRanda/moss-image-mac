From 1f937ef3adfca660ef5f308cf74ad5a44e3ff3f4 Mon Sep 17 00:00:00 2001
From: StefanVonRanda <16295563+StefanVonRanda@users.noreply.github.com>
Date: Tue, 20 Oct 2026 10:31:30 +0200
Subject: [PATCH 2/4] Allow several --lora PATH[:SCALE] adapters, applied in
 order

---
 moss_image_mlx/cli.py      | 16 ++++++++++++----
 moss_image_mlx/pipeline.py |  9 +++++----
 2 files changed, 17 insertions(+), 8 deletions(-)

diff --git a/moss_image_mlx/cli.py b/moss_image_mlx/cli.py
index aae255d..6b3f0d7 100644
--- a/moss_image_mlx/cli.py
+++ b/moss_image_mlx/cli.py
@@ -66,6 +66,14 @@ def quant_spec(text: str | None):
     return {"bits": int(bits), "group_size": int(group or 64)}
 
 
+def _lora_spec(text: str) -> tuple[str, float]:
+    """'path.safetensors' or 'path.safetensors:0.7'."""
+    path, sep, scale = text.rpartition(":")
+    if sep and scale.replace(".", "", 1).isdigit():
+        return path, float(scale)
+    return text, 1.0
+
+
 def _from_parameters(path) -> dict:
     params = json.load(open(path))["parameters"]
     return {"prompt": params["prompt"], "negative_prompt": params.get("negative_prompt", ""),
@@ -95,8 +103,8 @@ def main(argv=None):
     p.add_argument("--dit-dtype", choices=("bfloat16", "float32"), help="Transformer precision (default: as stored)")
     p.add_argument("--dit-quant", help="Quantize the transformer at load: 8, 6, 4g32, nvfp4, mxfp8 or JSON")
     p.add_argument("--te-quant", help="Quantize the text encoder at load (same forms)")
-    p.add_argument("--lora", help="LoRA safetensors (kohya or diffusers keys), applied unmerged to the transformer")
-    p.add_argument("--lora-scale", type=float, default=1.0)
+    p.add_argument("--lora", action="append", default=[], metavar="PATH[:SCALE]",
+                   help="LoRA safetensors (kohya or diffusers keys), applied unmerged; repeatable, e.g. --lora style.safetensors:0.8")
     p.add_argument("--precise", action="store_true", help="fp32 residual stream and elementwise ops (bf16 matmuls)")
     p.add_argument("--no-cache", action="store_true", help="Do not read or write the prompt-embedding cache")
     p.add_argument("--keep-resident", action="store_true", help="Do not free components between stages")
@@ -140,7 +148,7 @@ def main(argv=None):
     pipe = MOSSImagePipeline(args.model, args.transformer, low_memory=not args.keep_resident, dit_dtype=dtype,
                              dit_quant=quant_spec(args.dit_quant), te_quant=quant_spec(args.te_quant),
                              cache_dir=False if args.no_cache else None, precise=args.precise,
-                             lora=args.lora, lora_scale=args.lora_scale)
+                             loras=[_lora_spec(x) for x in args.lora])
     start = time.perf_counter()
 
     def progress(i, n):
@@ -151,7 +159,7 @@ def main(argv=None):
         print(file=sys.stderr)
         save(image, req, paths[id(req)], {"timings": dict(pipe.timings), "precise": args.precise,
                                           "dit_quant": args.dit_quant or "bf16", "te_quant": args.te_quant or "bf16",
-                                          "lora": args.lora, "lora_scale": args.lora_scale})
+                                          "loras": args.lora})
         print(paths[id(req)])
     print(json.dumps(pipe.timings), file=sys.stderr)
 
diff --git a/moss_image_mlx/pipeline.py b/moss_image_mlx/pipeline.py
index fc1f060..ee808a5 100644
--- a/moss_image_mlx/pipeline.py
+++ b/moss_image_mlx/pipeline.py
@@ -125,7 +125,7 @@ class MOSSImagePipeline:
     def __init__(self, model_dir: str | Path, transformer_dir: str | Path | None = None, low_memory: bool = True,
                  dit_dtype=None, dit_quant: dict | None = None, te_quant: dict | None = None,
                  cache_dir: str | Path | None | bool = None, precise: bool = False,
-                 lora: str | Path | None = None, lora_scale: float = 1.0):
+                 loras: list[tuple[str | Path, float]] = ()):
         """model_dir: a diffusers-layout MOSS-Image directory (transformer/, text_encoder/, tokenizer/, vae/).
         transformer_dir overrides the transformer only (Base and SFT share the text encoder and VAE).
         dit_quant / te_quant: quantization specs applied at load (see quantize.py).
@@ -136,7 +136,7 @@ class MOSSImagePipeline:
         self.low_memory = low_memory
         self.dit_dtype = dit_dtype  # None keeps the checkpoint's bf16; mx.float32 gives an fp32 reference run
         self.dit_quant, self.te_quant, self.precise = dit_quant, te_quant, precise
-        self.lora, self.lora_scale = lora, lora_scale
+        self.loras = list(loras)  # [(path, scale)], applied in order, unmerged
         self.text_encoder = self.transformer = self.vae = None
         self.cache = None
         if cache_dir is not False:
@@ -155,10 +155,11 @@ class MOSSImagePipeline:
         if self.transformer is None:
             model = load_transformer(self.transformer_dir, self.dit_dtype)
             quantize_dit(model, self.dit_quant)
-            if self.lora:
+            if self.loras:
                 from .lora import apply_lora
 
-                apply_lora(model, self.lora, self.lora_scale)
+                for path, scale in self.loras:
+                    apply_lora(model, path, scale)
             model.precise = self.precise
             self.transformer = model
 
-- 
