From 9390ba3f9867c1ba04e9bf3dbdd84de39a57480d Mon Sep 17 00:00:00 2001
From: StefanVonRanda <16295563+StefanVonRanda@users.noreply.github.com>
Date: Tue, 20 Oct 2026 13:59:23 +0200
Subject: [PATCH 5/8] Feather inpainting masks (--mask-feather, default 12 px)

A hard mask left a visible seam and a halo around regenerated text. The mask
is now dilated by the feather distance and its edge blurred over the same
distance; painted pixels stay fully regenerated, the ramp lives outside.
Both the latent blend and the final pixel blend use the soft values.

Checked: unit test on a synthetic rectangle (pytest 31 passed on 0.2.0);
the real inpainting run in the previous commit used the default 12 px
feather: no seam around the new awning lettering.
Not checked: feather widths other than 12 on real weights.
---
 moss_image_mlx/cli.py      |  3 ++-
 moss_image_mlx/pipeline.py | 17 ++++++++++++-----
 tests/test_i2i.py          | 16 ++++++++++++++++
 3 files changed, 30 insertions(+), 6 deletions(-)

diff --git a/moss_image_mlx/cli.py b/moss_image_mlx/cli.py
index 25f139d..dfda0d9 100644
--- a/moss_image_mlx/cli.py
+++ b/moss_image_mlx/cli.py
@@ -110,6 +110,7 @@ def main(argv=None):
     p.add_argument("--init", help="Image-to-image: start from this image (resized and centre-cropped to the size)")
     p.add_argument("--strength", type=float, help="Image-to-image strength 0..1 (default 0.6; 1 ignores the init)")
     p.add_argument("--mask", help="Inpainting mask for --init: white = regenerate, black = keep")
+    p.add_argument("--mask-feather", type=int, help="Grow the mask and soften its edge by this many px (default 12; 0 = hard edge)")
     p.add_argument("--width", type=int)
     p.add_argument("--height", type=int)
     p.add_argument("--steps", type=int)
@@ -148,7 +149,7 @@ def main(argv=None):
                   mx.bfloat16, "destripe"), (student, 1.0, mx.float32, "student"), *loras]
 
     base = _from_parameters(args.parameters) if args.parameters else {}
-    for name in ("prompt", "negative_prompt", "width", "height", "steps", "guidance", "shift", "seed", "strength", "mask"):
+    for name in ("prompt", "negative_prompt", "width", "height", "steps", "guidance", "shift", "seed", "strength", "mask", "mask_feather"):
         if getattr(args, name) is not None:
             base[name] = getattr(args, name)
     if args.init:
diff --git a/moss_image_mlx/pipeline.py b/moss_image_mlx/pipeline.py
index db5a4c5..009e120 100644
--- a/moss_image_mlx/pipeline.py
+++ b/moss_image_mlx/pipeline.py
@@ -48,6 +48,7 @@ class Request:
     init_image: str | None = None   # image-to-image: start from this image (resized and centre-cropped)
     strength: float = 0.6           # fraction of the schedule to run from the init; 1.0 = plain text-to-image
     mask: str | None = None         # inpainting: white = regenerate, black = keep (needs init_image)
+    mask_feather: int = 12          # px: grow the mask by this much, then soften its edge over the same distance
     # Per-step overrides (empty = off): an explicit sigma schedule ending in 0 (replaces steps/shift), and per-step
     # CFG scale and adapter strength, e.g. original model + CFG for the composition steps, then a turbo adapter.
     sigmas: list[float] = field(default_factory=list)
@@ -184,12 +185,18 @@ def load_image(path: str | Path, width: int, height: int) -> np.ndarray:
     return np.asarray(ImageOps.fit(Image.open(path).convert("RGB"), (width, height), Image.LANCZOS))
 
 
-def load_mask(path: str | Path, width: int, height: int) -> np.ndarray:
-    """0/1 float32 (height, width): white (>= 128) = regenerate."""
-    from PIL import Image
+def load_mask(path: str | Path, width: int, height: int, feather: int = 0) -> np.ndarray:
+    """float32 (height, width) in [0, 1]: white (>= 128) = regenerate. With feather > 0 the painted region is
+    dilated by `feather` px and its edge blurred over `feather` px, so the regenerated patch blends into its
+    surroundings instead of showing a hard seam; the painted pixels themselves stay fully regenerated."""
+    from PIL import Image, ImageFilter
 
     gray = Image.open(path).convert("L").resize((width, height), Image.BILINEAR)
-    return (np.asarray(gray) >= 128).astype(np.float32)
+    binary = Image.fromarray(((np.asarray(gray) >= 128) * 255).astype(np.uint8))
+    if feather > 0:
+        size = 2 * int(feather) + 1
+        binary = binary.filter(ImageFilter.MaxFilter(size)).filter(ImageFilter.GaussianBlur(feather / 2))
+    return np.asarray(binary).astype(np.float32) / 255.0
 
 
 class MOSSImagePipeline:
@@ -338,7 +345,7 @@ class MOSSImagePipeline:
                 pixels = load_image(r.init_image, r.width, r.height)
                 init = self.encode_image(pixels)
                 if r.mask:
-                    full_mask = load_mask(r.mask, r.width, r.height)
+                    full_mask = load_mask(r.mask, r.width, r.height, r.mask_feather)
                     mask = mx.array(latent_mask(full_mask, r.height, r.width))
             latents = self.denoise(r, pos, neg, on_step=on_step, keep=not last, init=init, mask=mask)
             td = time.perf_counter()
diff --git a/tests/test_i2i.py b/tests/test_i2i.py
index 4fef20c..80e1bfc 100644
--- a/tests/test_i2i.py
+++ b/tests/test_i2i.py
@@ -53,3 +53,19 @@ def test_pack_unpack_inverse():
 def test_turbo_rejects_an_init_image():
     with pytest.raises(ValueError, match="turbo"):
         Request(prompt="x", init_image="a.png", turbo=True).validate(42)
+
+
+def test_mask_feather(tmp_path):
+    import numpy as np
+    from PIL import Image
+
+    from moss_image_mlx.pipeline import load_mask
+
+    m = np.zeros((256, 256), np.uint8)
+    m[100:140, 60:200] = 255
+    Image.fromarray(m).save(tmp_path / "m.png")
+    hard = load_mask(tmp_path / "m.png", 256, 256, 0)
+    soft = load_mask(tmp_path / "m.png", 256, 256, 16)
+    assert hard[120, 100] == 1 and hard[90, 100] == 0
+    assert soft[120, 100] == 1.0, "painted pixels stay fully regenerated"
+    assert soft[94, 100] > 0.8 and 0 < soft[80, 100] < 0.8 and soft[60, 100] == 0, "dilated edge then a ramp to zero"
