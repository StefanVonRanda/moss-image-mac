diff --git a/moss_image_mlx/lora.py b/moss_image_mlx/lora.py
index 94adf9c..50d3dac 100644
--- a/moss_image_mlx/lora.py
+++ b/moss_image_mlx/lora.py
@@ -72,12 +72,16 @@ def apply_lora(model: nn.Module, path: str | Path, scale: float = 1.0) -> int:
             node = node[int(part)] if isinstance(node, list) else (node[part] if isinstance(node, dict) else getattr(node, part))
         rank = tensors["down"].shape[0]
         alpha = float(tensors.get("alpha", rank))
-        base = node[leaf] if isinstance(node, dict) else getattr(node, leaf)
-        wrapped = LoRALinear(base, tensors["down"], tensors["up"], scale * alpha / rank)
-        if isinstance(node, dict):
-            node[leaf] = wrapped
-        else:
-            setattr(node, leaf, wrapped)
+        ups = {leaf: tensors["up"]}
+        if leaf == "qkv" and isinstance(node, dict) and "qkv" not in node:  # trainers that fuse q, k, v (ai-toolkit)
+            ups = dict(zip("qkv", mx.split(tensors["up"], 3, axis=0)))  # one shared down, each its slice of up
+        for leaf, up in ups.items():
+            base = node[leaf] if isinstance(node, dict) else getattr(node, leaf)
+            wrapped = LoRALinear(base, tensors["down"], up, scale * alpha / rank)
+            if isinstance(node, dict):
+                node[leaf] = wrapped
+            else:
+                setattr(node, leaf, wrapped)
         count += 1
     if count != len(mods):
         raise ValueError("LoRA modules not all applied")
