From d54ee136d64e20563ac0ead6abc3f28211484fd1 Mon Sep 17 00:00:00 2001
From: StefanVonRanda <16295563+StefanVonRanda@users.noreply.github.com>
Date: Fri, 23 Oct 2026 19:56:36 +0200
Subject: [PATCH] Load sd-scripts' legacy lora_unet_ LoRA keys

Older kohya exports (and many ComfyUI LoRAs, e.g. Ashen Whispers) name
modules lora_unet_layers_9_proj_o with underscores instead of dots, so
load_lora raised "unrecognized LoRA key: lora_unet_layers_9_proj_o.alpha".
Normalize those keys to the same layered path; leaf names with underscores
(ffn_up_gate, ffn_down) are matched whole, not split.

Checked: pytest tests/ passes (32 tests); both new LoRAs in ~/moss-mlx/loras
group into complete down/up/alpha modules.
---
 moss_image_mlx/lora.py | 26 +++++++++++++++++++++-----
 tests/test_lora.py     | 26 ++++++++++++++++++++------
 2 files changed, 41 insertions(+), 11 deletions(-)

diff --git a/moss_image_mlx/lora.py b/moss_image_mlx/lora.py
index a6f813e..c2dc393 100644
--- a/moss_image_mlx/lora.py
+++ b/moss_image_mlx/lora.py
@@ -24,6 +24,24 @@ F32 = mx.float32
 # diffusers/peft: transformer.layers.3.proj.q.{lora_A.weight,lora_B.weight}
 _KEY = re.compile(r"^(?:diffusion_model|transformer)\.(.+?)\.(lora_down|lora_up|lora_A|lora_B|alpha)(?:\.weight)?$")
 
+# sd-scripts' older export, still what many ComfyUI LoRAs ship: `lora_unet_` plus the dotted path with
+# its dots replaced by underscores, so the leaf names keep their own underscores:
+# lora_unet_layers_3_proj_ffn_up_gate.{lora_down.weight,lora_up.weight,alpha}
+_LEGACY_KEY = re.compile(
+    r"^lora_unet_layers_(\d+)_proj_(q|k|v|o|qkv|ffn_up_gate|ffn_down)\.(lora_down|lora_up|alpha)(?:\.weight)?$"
+)
+
+
+def _split_key(key: str) -> tuple[str, str]:
+    """Module path and slot (lora_down/lora_up/lora_A/lora_B/alpha) for one LoRA tensor key."""
+    m = _KEY.match(key)
+    if m:
+        return m.group(1), m.group(2)
+    m = _LEGACY_KEY.match(key)
+    if m:
+        return f"layers.{m.group(1)}.proj.{m.group(2)}", m.group(3)
+    raise ValueError(f"unrecognized LoRA key: {key}")
+
 
 class LoRALinear(nn.Module):
     def __init__(self, base: nn.Module, down: mx.array, up: mx.array, scale: float):
@@ -41,11 +59,9 @@ def load_lora(path: str | Path) -> dict[str, dict]:
     """Group a LoRA safetensors file by module path: {"layers.3.proj.q": {"down": ..., "up": ..., "alpha": ...}}."""
     mods: dict[str, dict] = {}
     for key, value in mx.load(str(path)).items():
-        m = _KEY.match(key)
-        if not m:
-            raise ValueError(f"unrecognized LoRA key: {key}")
-        slot = {"lora_down": "down", "lora_A": "down", "lora_up": "up", "lora_B": "up", "alpha": "alpha"}[m.group(2)]
-        mods.setdefault(m.group(1), {})[slot] = value
+        name, slot_key = _split_key(key)
+        slot = {"lora_down": "down", "lora_A": "down", "lora_up": "up", "lora_B": "up", "alpha": "alpha"}[slot_key]
+        mods.setdefault(name, {})[slot] = value
     return mods
 
 
diff --git a/tests/test_lora.py b/tests/test_lora.py
index 2bf49db..a06cb39 100644
--- a/tests/test_lora.py
+++ b/tests/test_lora.py
@@ -13,7 +13,7 @@ MODULES = ("q", "k", "v", "o", "ffn_up_gate", "ffn_down")
 
 
 def _write_lora(path, model, rank=4, alpha=2.0, fmt="kohya"):
-    """A random adapter for every proj linear of every block, in kohya or diffusers/PEFT key format."""
+    """A random adapter for every proj linear of every block, in kohya, older kohya or diffusers/PEFT keys."""
     rng = np.random.default_rng(0)
     tensors = {}
     for i, block in enumerate(model.layers):
@@ -26,6 +26,11 @@ def _write_lora(path, model, rank=4, alpha=2.0, fmt="kohya"):
                 tensors[f"{base}.lora_down.weight"] = mx.array(down)
                 tensors[f"{base}.lora_up.weight"] = mx.array(up)
                 tensors[f"{base}.alpha"] = mx.array(alpha, dtype=mx.float32)
+            elif fmt == "kohya_legacy":
+                base = f"lora_unet_layers_{i}_proj_{name}"
+                tensors[f"{base}.lora_down.weight"] = mx.array(down)
+                tensors[f"{base}.lora_up.weight"] = mx.array(up)
+                tensors[f"{base}.alpha"] = mx.array(alpha, dtype=mx.float32)
             else:
                 base = f"transformer.layers.{i}.proj.{name}"
                 tensors[f"{base}.lora_A.weight"] = mx.array(down)
@@ -46,13 +51,20 @@ def test_load_lora_groups_keys(tmp_path, tiny):
     assert set(mods["layers.0.proj.q"]) == {"down", "up", "alpha"}
 
 
+def test_load_lora_legacy_underscore_keys(tmp_path, tiny):
+    _write_lora(tmp_path / "legacy.safetensors", tiny, fmt="kohya_legacy")
+    mods = load_lora(tmp_path / "legacy.safetensors")
+    assert set(mods) == {f"layers.{i}.proj.{n}" for i in range(2) for n in MODULES}
+    assert set(mods["layers.1.proj.ffn_up_gate"]) == {"down", "up", "alpha"}
+
+
 def test_unknown_key_rejected(tmp_path):
     mx.save_safetensors(str(tmp_path / "bad.safetensors"), {"something.else": mx.zeros((2, 2))})
     with pytest.raises(ValueError, match="unrecognized"):
         load_lora(tmp_path / "bad.safetensors")
 
 
-@pytest.mark.parametrize("fmt", ["kohya", "diffusers"])
+@pytest.mark.parametrize("fmt", ["kohya", "kohya_legacy", "diffusers"])
 def test_apply_matches_formula(tmp_path, tiny, fmt):
     tensors = _write_lora(tmp_path / "a.safetensors", tiny, rank=4, alpha=2.0, fmt=fmt)
     x = mx.random.normal((1, 3, 64)).astype(mx.bfloat16)
@@ -60,10 +72,12 @@ def test_apply_matches_formula(tmp_path, tiny, fmt):
     assert apply_lora(tiny, tmp_path / "a.safetensors", scale=0.5) == 12
     layer = tiny.layers[1].proj["o"]
     assert isinstance(layer, LoRALinear)
-    prefix = "diffusion_model.layers.1.proj.o" if fmt == "kohya" else "transformer.layers.1.proj.o"
-    down = tensors[f"{prefix}.lora_down.weight" if fmt == "kohya" else f"{prefix}.lora_A.weight"]
-    up = tensors[f"{prefix}.lora_up.weight" if fmt == "kohya" else f"{prefix}.lora_B.weight"]
-    alpha = 2.0 if fmt == "kohya" else 4.0  # diffusers files carry no alpha: defaults to rank
+    prefix = {"kohya": "diffusion_model.layers.1.proj.o",
+              "kohya_legacy": "lora_unet_layers_1_proj_o",
+              "diffusers": "transformer.layers.1.proj.o"}[fmt]
+    down = tensors[f"{prefix}.lora_down.weight" if fmt != "diffusers" else f"{prefix}.lora_A.weight"]
+    up = tensors[f"{prefix}.lora_up.weight" if fmt != "diffusers" else f"{prefix}.lora_B.weight"]
+    alpha = 2.0 if fmt != "diffusers" else 4.0  # diffusers files carry no alpha: defaults to rank
     expect = before + ((x.astype(mx.float32) @ down.T @ up.T) * (0.5 * alpha / 4)).astype(x.dtype)
     assert mx.allclose(layer(x), expect, atol=1e-2, rtol=1e-2).item()
 
